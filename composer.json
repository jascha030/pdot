{
    "name": "jascha030/pdot",
    "description": "Dotfile management CLI.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jascha030",
            "email": "contact@jaschavanaalst.nl"
        }
    ],
    "homepage": "https://github.com/jascha030",
    "bin": [
        "pdot"
    ],
    "autoload": {
        "files": [
            "includes/cli.php",
            "includes/container.php"
        ],
        "psr-4": {
            "Jascha030\\Dotfiles\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jascha030\\Dotfiles\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.3",
        "jascha030/cli": "^1.2",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/finder": "^7.0 || ^8.0",
        "symfony/filesystem": "^7.0 || ^8.0",
        "php-di/php-di": "^7.1",
        "illuminate/collections": "^12.49"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "roave/security-advisories": "dev-latest",
        "symfony/var-dumper": "^7.0 || ^8.0"
    },
    "scripts": {
        "post-install-cmd": [
            "@install-phive-dependencies"
        ],
        "install-phive-dependencies": [
            "@putenv XDEBUG_MODE=off",
            "@putenv COMPOSER_ALLOW_SUPERUSER=1",
            "phive install --trust-gpg-keys 4AA394086372C20A 1> /dev/null",
            "@php -r \" ! file_exists('tools/phpunit.xsd') && (new Phar('tools/phpunit.phar'))->extractTo('tools', 'phpunit.xsd');\""
        ],
        "test": [
            "@putenv XDEBUG_MODE=coverage",
            "@php -d error_reporting=E_ALL -d display_errors=1 tools/phpunit.phar -c phpunit.xml"
        ],
        "format": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
